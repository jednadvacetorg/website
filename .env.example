# Tento soubor zkopíruj na .env, jinak nebude fungovat Dev Container.
# (Není nutné klíče vyplňovat pokud je nepotřebuješ.)

# API klíč získej na: https://ppq.ai/api-docs
PPQ_API_KEY=

# Lokální runtime konfigurace. Produkční hodnoty nastav v Cloudflare dashboardu.
NUXT_GOOGLE_OAUTH_CLIENT_ID=
NUXT_GOOGLE_LEGACY_CALENDAR_ID=

# Citlivé hodnoty nastav v produkci jako Cloudflare Worker secrets.
NUXT_PORTAL_WEBHOOK_SECRET=
NUXT_GOOGLE_OAUTH_SECRET=
NUXT_GOOGLE_OAUTH_REFRESH_TOKEN=
NUXT_EVENTS_ADMIN_TOKEN=
NUXT_MAPBOX_ACCESS_TOKEN=

# Notification lifecycle key is a private Cloudflare Worker secret. Generate one
# unpadded base64url 32-byte value. HKDF derives distinct outbox, suppression,
# and abuse keys internally. Replacing it can temporarily make retained work unavailable.
NUXT_NOTIFICATION_COMMUNITY_SLUGS=
NUXT_NOTIFICATION_ROOT_KEY=
NUXT_NOTIFICATION_TURNSTILE_SECRET=
NUXT_NOTIFICATION_TURNSTILE_EXPECTED_HOSTNAME=
# This site key is public. Keep the Turnstile secret and expected hostname above private.
NUXT_PUBLIC_NOTIFICATION_TURNSTILE_SITE_KEY=
NUXT_NOTIFICATION_CONSENT_VERSION=
# Private, operator-owned expected identity of the reviewed target/deployment and
# SHA-256 bundle/migration/configuration artifacts. Never use local test evidence.
NUXT_NOTIFICATION_EXPECTED_TARGET_IDENTITY=
NUXT_NOTIFICATION_EXPECTED_DEPLOYMENT_ID=
NUXT_NOTIFICATION_EXPECTED_BUNDLE_HASH=
NUXT_NOTIFICATION_EXPECTED_MIGRATION_HASH=
NUXT_NOTIFICATION_EXPECTED_CONFIG_HASH=
# JSON uses the 06-15 readiness envelope: channel, production-observation kind,
# readiness mode, manualSwitch, exact identities, verifiedAt, expiresAt and gates.
# Maximum validity is 24 hours; the operator must revalidate after deployment,
# schema or key changes. No automatic renewal. Additional firstMessage/eventDelivery
# gates and keyHash bind actual message proofs and current private key/provider identity.
# keyHash is SHA-256 of a JSON array, in this exact order:
# email: root, Brevo API key, callback secret, sender name, sender email;
# SMS: root, Brevo API key, SMS sender;
# push: root, VAPID private scalar, public key, subject.
# SMS gates: sender/account/credits/country/compliance/sharedManagementStop/liveCanary.
# Push gates: vapid/protocol/interoperability/sharedManagementStop/liveCanary, plus
# browser:<family> for each declared interoperability family (chromium, firefox,
# safari-macos, ios-home-screen). Common artifact/deployment/binding/migration gates apply.
NUXT_NOTIFICATION_EMAIL_EVIDENCE=
NUXT_NOTIFICATION_SMS_EVIDENCE=
NUXT_NOTIFICATION_WEB_PUSH_EVIDENCE=
# Only require deliveryCallbackAuth when a supported, authenticated SMS delivery
# callback is actually configured. Provider-specific opt-out events are not required.
NUXT_NOTIFICATION_SMS_DELIVERY_CALLBACKS_CONFIGURED=false
NUXT_NOTIFICATION_EMAIL_SMS_ENABLED=false
NUXT_NOTIFICATION_EMAIL_SMS_FIRST_MESSAGE_READY=false
NUXT_NOTIFICATION_EMAIL_SMS_EVENT_DELIVERY_READY=false
NUXT_NOTIFICATION_SMS_ENABLED=false
NUXT_NOTIFICATION_SMS_FIRST_MESSAGE_READY=false
NUXT_NOTIFICATION_SMS_EVENT_DELIVERY_READY=false
# Brevo delivery stays fail-closed without current bounded observations above.
# Keep API/callback values private.
NUXT_BREVO_API_KEY=
NUXT_BREVO_CALLBACK_SECRET=
NUXT_BREVO_SENDER_NAME=
NUXT_BREVO_SMS_SENDER=
NUXT_BREVO_SENDER_EMAIL=noreply@jednadvacet.org
NUXT_NOTIFICATION_EMAIL_MANUAL_ENABLED=false
NUXT_NOTIFICATION_WEB_PUSH_ENABLED=false
NUXT_NOTIFICATION_WEB_PUSH_FIRST_MESSAGE_READY=false
NUXT_NOTIFICATION_WEB_PUSH_EVENT_DELIVERY_READY=false
# Keep the private P-256 scalar in a Worker secret. The public uncompressed
# P-256 key is intentionally exposed to browsers so PushManager can subscribe.
NUXT_NOTIFICATION_VAPID_PRIVATE_KEY=
NUXT_NOTIFICATION_VAPID_SUBJECT=mailto:notifications@jednadvacet.org
NUXT_PUBLIC_NOTIFICATION_VAPID_PUBLIC_KEY=
