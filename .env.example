# Tento soubor zkopíruj na .env, jinak nebude fungovat Dev Container.
# (Není nutné klíče vyplňovat pokud je nepotřebuješ.)

# API klíč získej na: https://ppq.ai/api-docs
PPQ_API_KEY=

# Lokální runtime konfigurace. Produkční hodnoty nastav v Cloudflare dashboardu.
NUXT_GOOGLE_OAUTH_CLIENT_ID=
NUXT_GOOGLE_LEGACY_CALENDAR_ID=

# Citlivé hodnoty nastav v produkci jako Cloudflare Worker secrets.
NUXT_PORTAL_WEBHOOK_SECRET=
NUXT_GOOGLE_OAUTH_SECRET=
NUXT_GOOGLE_OAUTH_REFRESH_TOKEN=
NUXT_EVENTS_ADMIN_TOKEN=
NUXT_MAPBOX_ACCESS_TOKEN=

# Notification lifecycle key is a private Cloudflare Worker secret. Generate one
# unpadded base64url 32-byte value. HKDF derives distinct outbox, suppression,
# and abuse keys internally. Replacing it can temporarily make retained work unavailable.
NUXT_NOTIFICATION_ROOT_KEY=
NUXT_NOTIFICATION_TURNSTILE_SECRET=
NUXT_NOTIFICATION_TURNSTILE_EXPECTED_HOSTNAME=
# Public site key: supply during build as well as runtime for prerendered pages.
# Keep the Turnstile secret and expected hostname above private.
NUXT_PUBLIC_NOTIFICATION_TURNSTILE_SITE_KEY=
# Real provider/device observations belong to the release checklist, not runtime settings.
# Brevo delivery requires complete provider configuration and the actual database schema.
# Keep API/callback values private.
NUXT_BREVO_API_KEY=
NUXT_BREVO_CALLBACK_SECRET=
NUXT_BREVO_SENDER_NAME=
NUXT_BREVO_SMS_SENDER=
NUXT_BREVO_SENDER_EMAIL=noreply@jednadvacet.org
# Keep the private P-256 scalar in a Worker secret. The public uncompressed
# P-256 key is intentionally exposed to browsers so PushManager can subscribe.
# Supply the public key at build time too; retain separate test/production pairs.
NUXT_NOTIFICATION_VAPID_PRIVATE_KEY=
NUXT_NOTIFICATION_VAPID_SUBJECT=mailto:notifications@jednadvacet.org
NUXT_PUBLIC_NOTIFICATION_VAPID_PUBLIC_KEY=
