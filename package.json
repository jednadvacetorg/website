{
  "name": "jednadvacet-org",
  "private": true,
  "type": "module",
  "scripts": {
    "skills:install": "skills experimental_install -y",
    "build": "node --experimental-strip-types scripts/validate-content-routes.ts && NODE_OPTIONS=--max-old-space-size=4096 nuxt build",
    "build:cloudflare": "CLOUDFLARE_DEPLOY=1 npm run build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "nuxt typecheck",
    "dev": "CHOKIDAR_USEPOLLING=1 CHOKIDAR_INTERVAL=500 nuxt dev --port 2103",
    "dev:tunnel": "UNTUN_ACCEPT_CLOUDFLARE_NOTICE=true npm run dev -- --tunnel"
  },
  "dependencies": {
    "@counterscale/tracker": "^3.4.1",
    "@libsql/client": "^0.18.0",
    "@nuxt/content": "^3.11.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.4.0",
    "@nuxthub/core": "^0.10.7",
    "@nuxtjs/sitemap": "^8.2.1",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "ical.js": "^2.2.1",
    "nuxt": "^4.3.0",
    "nuxt-studio": "^1.5.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@iconify-json/bitcoin-icons": "^1.2.5",
    "@iconify-json/lucide": "^1.2.98",
    "@iconify-json/pinhead": "^1.2.26",
    "@iconify-json/simple-icons": "^1.2.94",
    "@iconify-json/streamline": "^1.2.5",
    "@nuxt/kit": "^4.4.2",
    "@types/node": "^24.12.0",
    "@types/qrcode": "^1.5.6",
    "@vue/language-core": "^3.2.6",
    "@vueuse/core": "^14.2.1",
    "@vueuse/nuxt": "^14.2.1",
    "better-sqlite3": "^13.0.3",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.9",
    "wrangler": "^4.102.0"
  }
}
